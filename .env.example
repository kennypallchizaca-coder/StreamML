# =========================================================================
# Plantilla de desarrollo local (no usar en producción).
# Copiar a .env para ejecutar la API fuera de Docker. Para producción, copiar
# deployment/.env.example a deployment/.env y usar --env-file deployment/.env.

# Entorno y Secretos
STREAMML_ENVIRONMENT=development
STREAMML_TOKEN_SECRET=local_development_token_secret_at_least_32_characters
STREAMML_MEDIA_AUTH_SECRET=local_development_media_secret_at_least_32_characters

# Configuración de Red
STREAMML_ALLOWED_ORIGINS=http://localhost:5173
STREAMML_MEDIAMTX_PUBLIC_BASE=http://localhost/media
STREAMML_MEDIAMTX_RTMP_PUBLISH_BASE=rtmp://127.0.0.1:1935
# URL privada del API de MediaMTX dentro de Docker; no se expone públicamente.
STREAMML_MEDIAMTX_API_URL=http://mediamtx:9997

# Administrador del Sistema
STREAMML_BOOTSTRAP_EMAIL=admin@localhost.com
STREAMML_BOOTSTRAP_PASSWORD=local-development-password-change-me

# Base de Datos y Cookies
STREAMML_DATABASE_PATH=deployment/streamml.sqlite3
STREAMML_COOKIE_SECURE=false
STREAMML_ENFORCE_HTTPS=false

# Configuración exclusiva para el Conector OBS (Si ejecutas OBS localmente)
STREAMML_API_URL=https://localhost
STREAMML_CONNECTOR_NAME=
STREAMML_SESSION_ID=
OBS_WEBSOCKET_HOST=127.0.0.1
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=
